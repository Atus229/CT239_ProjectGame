  m_Script: {fileID: 11500000, guid: 90a2c1129a9c3b842b0ea01e4adf0029, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::_Project.Scripts.Ui.TutorialUI
  btnClose: {fileID: 1561656027952800581}
  btnPrev: {fileID: 3990241265471827679}
  btnNext: {fileID: 506270201473346884}
  txtNextLabel: {fileID: 9177445970893735335}
  imgIllustration: {fileID: 4075050565254282703}
  txtTitle: {fileID: 6083310047775445208}
  txtDescription: {fileID: 442826585670722112}
  txtPageCounter: {fileID: 3895690550307989910}
  pageDots:
  - {fileID: 7551928123651972591}
  - {fileID: 2265993845142242715}
  - {fileID: 4650010239573885105}
  - {fileID: 8671074566664570615}
  activeDotColor: {r: 0.95, g: 0.45, b: 0.22, a: 1}
  inactiveDotColor: {r: 0.6, g: 0.65, b: 0.7, a: 0.5}
  pages:
  - stepTitle: "1. Ch\u1ECDn \u0110\u01A1n H\xE0ng & Xem Gi\u1EDD"
    stepDescription: "M\u1ED7i ng\xE0y c\xF3 m\u1ED9t Qu\u1EF9 th\u1EDDi gian c\u1ED1
      \u0111\u1ECBnh. Ki\u1EC3m tra Khung gi\u1EDD m\u1EE5c ti\xEAu [Tmin, Tmax]
      v\xE0 ch\u1ECDn \u0111\u01A1n c\xF3 th\u1EDDi gian t\u1ED1i thi\u1EC3u kh\xF4ng
      v\u01B0\u1EE3t qu\xE1 qu\u1EF9 gi\u1EDD c\xF2n l\u1EA1i."
    stepIllustration: {fileID: 0}
  - stepTitle: "2. K\xE9o Th\u1EA3 & Xoay \u0110\u1ED3 (Ph\xEDm R)"
    stepDescription: "K\xE9o h\xE0ng t\u1EEB khay ch\u1EDD v\xE0o l\u01B0\u1EDBi
      khoang xe. Nh\u1EA5n ph\xEDm R \u0111\u1EC3 xoay h\xE0ng 90\xB0 cho v\u1EEBa
      \xF4 tr\u1ED1ng. Kh\xF4ng c\xF3 \u0111\u1ED3ng h\u1ED3 \u0111\u1EBFm ng\u01B0\u1EE3c
      n\xEAn b\u1EA1n c\xF3 th\u1EC3 th\u1EED v\xE0 g\u1EE1 h\xE0ng tho\u1EA3i m\xE1i."
    stepIllustration: {fileID: 0}
  - stepTitle: "3. M\u1ED1c Xanh 5 Sao & Giao Tr\u1EC5"
    stepDescription: "X\u1EBFp h\xE0ng sao cho t\u1ED5ng th\u1EDDi gian n\u1EB1m
      trong v\xF9ng xanh [Tmin, Tmax] \u0111\u1EC3 \u0111\u1EA1t 5 Sao. N\u1EBFu
      v\u01B0\u1EE3t qu\xE1 Tmax, \u0111\u01A1n v\u1EABn giao \u0111\u01B0\u1EE3c
      nh\u01B0ng s\u1EBD b\u1ECB t\xEDnh giao tr\u1EC5 v\xE0 tr\u1EEB sao."
    stepIllustration: {fileID: 0}
  - stepTitle: "4. D\xF9ng Ti\u1EC1n N\xE2ng C\u1EA5p Xe"
    stepDescription: "Ho\xE0n th\xE0nh \u0111\u01A1n \u0111\u1EC3 nh\u1EADn ti\u1EC1n
      th\u01B0\u1EDFng v\xE0 uy t\xEDn. D\xF9ng ti\u1EC1n trong Shop \u0111\u1EC3
      m\u1EDF r\u1ED9ng th\xF9ng xe, t\u0103ng qu\u1EF9 th\u1EDDi gian ng\xE0y v\xE0
      t\u0103ng t\u1ED1c \u0111\u1ED9 x\u1EED l\xFD h\xE0ng."
    stepIllustration: {fileID: 0}
